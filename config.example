# f5-cli settings. Copy to ~/.config/f5-cli/config. Environment variables of
# the same name override anything set here.

# The APM portal you sign in to.
F5_PORTAL=portal.platform.hmcts.net

# The network-access resource to launch. Leave unset to use the one your
# access policy grants; set it only if the portal offers more than one.
#F5_RESOURCE=/Common/netacl_mojvpn

# A Chromium-family browser for the sign-in. Found on PATH when unset
# (google-chrome, chromium, microsoft-edge, brave-browser).
#F5_BROWSER=/usr/bin/google-chrome

# Where f5-cli keeps its own browser profile.
#F5_BROWSER_PROFILE=~/.local/share/f5-cli/browser

# The F5 client binary.
#F5_CLIENT=/usr/bin/f5vpn-ng
