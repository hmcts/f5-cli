#!/usr/bin/env bash
# f5-cli — connect to an F5 BIG-IP APM VPN from the terminal with the F5
# client (f5vpn-ng on Linux, F5 VPN on macOS): no webtop clicking.
#
# The portal is SAML-federated to Entra ID, so the sign-in itself can't be
# scripted. Instead f5-cli keeps a browser profile of its own: `login` opens a
# window for one interactive sign-in, and the persistent Entra cookie left
# behind lets the same browser repeat the SAML round trip headlessly from then
# on. The access policy then waits on an endpoint inspection that the browser
# farms out to the native client over f5-epi:// — headless Chrome won't launch
# an external protocol, so f5-cli runs that step itself. With a live portal
# session in hand, the launch URI is built the way the webtop's JS does and
# handed to the client — headless on Linux when no display is available.
#
# Written for bash 3.2, so it runs on the /bin/bash macOS ships.
set -euo pipefail

VERSION=0.3.0
CONFIG=${F5_CLI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/f5-cli/config}
OS=$(uname -s)

if [ -t 2 ]; then
  msg()  { printf '\033[1;32m[+]\033[0m %s\n' "$*" >&2; }
  warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
  die()  { printf '\033[1;31m[-]\033[0m %s\n' "$*" >&2; exit 1; }
else
  msg()  { printf '[+] %s\n' "$*" >&2; }
  warn() { printf '[!] %s\n' "$*" >&2; }
  die()  { printf '[-] %s\n' "$*" >&2; exit 1; }
fi

case $OS in
  Linux|Darwin) ;;
  *) die "f5-cli supports Linux and macOS, not $OS" ;;
esac

# KEY=value lines; anything already set in the environment wins.
load_config() {
  local key value
  [ -r "$CONFIG" ] || return 0
  while IFS='=' read -r key value; do
    key=${key//[[:space:]]/}
    case $key in
      F5_PORTAL|F5_RESOURCE|F5_BROWSER|F5_BROWSER_PROFILE|F5_CLIENT|F5_EPI|F5_CLI_NETWORK_WAIT) ;;
      *) continue ;;
    esac
    [ -z "${!key:-}" ] || continue
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    value=${value#[\"\']}; value=${value%[\"\']}
    [[ $value == \~/* ]] && value=$HOME/${value#\~/}
    printf -v "$key" '%s' "$value"
  done < <(sed -e 's/^[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$CONFIG")
}
load_config

PORTAL=${F5_PORTAL:-portal.platform.hmcts.net}
RESOURCE=${F5_RESOURCE:-}
NETWORK_WAIT=${F5_CLI_NETWORK_WAIT:-0}
DATADIR=${XDG_DATA_HOME:-$HOME/.local/share}/f5-cli
STATEDIR=${XDG_STATE_HOME:-$HOME/.local/state}/f5-cli
SIDFILE=$STATEDIR/sid
# F5_RESOLV_CONF is for the tests.
RESOLV_CONF=${F5_RESOLV_CONF:-/etc/resolv.conf}

# On Linux one binary, f5vpn-ng, handles both f5-vpn:// and f5-epi://. On
# macOS they are two apps, and both are driven through LaunchServices.
if [ "$OS" = Darwin ]; then
  CLIENT=${F5_CLIENT:-/Applications/F5 VPN.app}
  EPI=${F5_EPI:-/Applications/F5 Endpoint Inspector.app}
  CLIENT_NAME="F5 VPN"
  CLIENT_HELP="install the macOS client (F5 VPN and F5 Endpoint Inspector) from the webtop at https://$PORTAL/"
  CLIENT_LOGS=$HOME/Library/Logs/F5Networks/vpn.log
else
  CLIENT=${F5_CLIENT:-$(command -v f5vpn-ng || printf /usr/bin/f5vpn-ng)}
  EPI=$CLIENT
  CLIENT_NAME=f5vpn-ng
  CLIENT_HELP="download the Linux client from https://$PORTAL/ and install it"
  CLIENT_LOGS=$HOME/.F5Networks/f5vpn.log
fi

if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  RUNDIR=$XDG_RUNTIME_DIR/f5-cli
elif [ "$OS" = Darwin ] && [ -n "${TMPDIR:-}" ]; then
  RUNDIR=${TMPDIR%/}/f5-cli
else
  RUNDIR=/tmp/f5-cli-$(id -u)
fi
mkdir -p "$RUNDIR" && chmod 700 "$RUNDIR"
[ -O "$RUNDIR" ] || die "$RUNDIR is not owned by you"
CLIENT_LOG=$RUNDIR/client.log
IFACE_FILE=$RUNDIR/iface

# A macOS app bundle given as the browser means the executable inside it.
app_binary() {
  local name
  if [ -d "$1" ] && [ -d "$1/Contents/MacOS" ]; then
    name=$(basename "$1" .app)
    [ -x "$1/Contents/MacOS/$name" ] && { printf '%s' "$1/Contents/MacOS/$name"; return 0; }
  fi
  printf '%s' "$1"
}

find_browser() {
  local b d
  if [ -n "${F5_BROWSER:-}" ]; then
    app_binary "$F5_BROWSER"; return 0
  fi
  if [ "$OS" = Darwin ]; then
    for b in "Google Chrome" Chromium "Microsoft Edge" "Brave Browser"; do
      for d in /Applications "$HOME/Applications"; do
        [ -x "$d/$b.app/Contents/MacOS/$b" ] && { printf '%s' "$d/$b.app/Contents/MacOS/$b"; return 0; }
      done
    done
    return 1
  fi
  for b in google-chrome google-chrome-stable chromium chromium-browser \
           microsoft-edge microsoft-edge-stable brave-browser; do
    command -v "$b" && return 0
  done
  return 1
}

# Snap-confined browsers can't reach hidden directories in $HOME, so their
# profile has to live in the snap's own data directory instead.
snap_name() {
  [ "$OS" = Linux ] || return 1
  case $1 in /snap/bin/*) basename "$1"; return 0 ;; esac
  [ -f "$1" ] && [ "$(head -c 2 "$1")" = '#!' ] || return 1
  grep -o -m1 '/snap/bin/[A-Za-z0-9_-]*' "$1" | xargs -r basename
}

BROWSER=$(find_browser) || BROWSER=
if [ -n "${F5_BROWSER_PROFILE:-}" ]; then
  PROFILE=$F5_BROWSER_PROFILE
elif snap=$(snap_name "$BROWSER" 2>/dev/null) && [ -n "$snap" ]; then
  PROFILE=$HOME/snap/$snap/common/f5-cli
else
  PROFILE=$DATADIR/browser
fi

# Whether a window can be opened: an X11/Wayland display on Linux, the
# logged-in Aqua session on macOS (not, say, an ssh login).
has_display() {
  if [ "$OS" = Darwin ]; then
    [ "$(launchctl managername 2>/dev/null)" = Aqua ]
  else
    [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]
  fi
}

# timeout(1) is GNU coreutils; macOS has none unless Homebrew put one there.
# A shell watcher won't do: its sleep outlives the command, holding the copy
# of the lock's fd that bash keeps while a function's fd 9 is redirected.
with_timeout() {
  if command -v timeout >/dev/null; then
    timeout "$@"
    return
  fi
  python3 -I -c '
import subprocess, sys
try:
    sys.exit(subprocess.run(sys.argv[2:], timeout=float(sys.argv[1])).returncode)
except subprocess.TimeoutExpired:
    sys.exit(124)
' "$@"
}

resolves() {
  python3 -I -c 'import socket, sys; socket.getaddrinfo(sys.argv[1], 443)' "$1" >/dev/null 2>&1
}

# --- the tunnel ---------------------------------------------------------------
#
# On Linux svpn always brings up tun0. On macOS it takes the next free utun,
# and macOS keeps several utuns of its own, so the one that appears during
# `up` is remembered in $IFACE_FILE.

# Tunnel-style interfaces holding an IPv4 address, one per line.
tunnel_candidates() {
  if [ "$OS" = Darwin ]; then
    ifconfig 2>/dev/null | awk '
      /^[^ \t]/ { i = $1; sub(/:$/, "", i) }
      $1 == "inet" && i ~ /^(utun|tun|ppp)[0-9]+$/ { print i }' | sort -u
  else
    # ip fails while tun0 doesn't exist, which pipefail would make fatal.
    { ip -4 -o addr show tun0 2>/dev/null || true; } | awk '{print $2}' | sort -u
  fi
}

has_ipv4() {
  if [ "$OS" = Darwin ]; then
    ifconfig "$1" 2>/dev/null | awk '$1 == "inet" {f = 1} END {exit !f}'
  else
    ip -4 addr show "$1" 2>/dev/null | grep -q inet
  fi
}

# The VPN's interface, if there is one. On Linux tun0 counts while it exists,
# addressed or not, so a half-built tunnel is spotted and torn down.
tunnel_iface() {
  local i n
  if [ "$OS" = Linux ]; then
    ip link show tun0 >/dev/null 2>&1 && { printf tun0; return 0; }
    return 1
  fi
  i=$(cat "$IFACE_FILE" 2>/dev/null) || i=
  if [ -n "$i" ] && has_ipv4 "$i"; then
    printf '%s' "$i"; return 0
  fi
  # Connected some other way, say from the webtop: with svpn up and a single
  # addressed tunnel interface, that is the one.
  pgrep -x svpn >/dev/null || return 1
  i=$(tunnel_candidates)
  n=$(printf '%s' "$i" | grep -c . || true)
  [ "$n" -eq 1 ] || return 1
  printf '%s' "$i"
}

tunnel_addr() {
  if [ "$OS" = Darwin ]; then
    ifconfig "$1" 2>/dev/null | awk '$1 == "inet" {print $2; exit}'
  else
    ip -4 -br addr show "$1" | awk '{print $3}'
  fi
}

route_count() {
  [ -n "${1:-}" ] || { echo 0; return 0; }
  if [ "$OS" = Darwin ]; then
    netstat -rn -f inet 2>/dev/null | awk -v t="$1" '$4 == t {n++} END {print n + 0}'
  else
    ip route show 2>/dev/null | grep -c "$1" || true
  fi
}

# The VPN's resolvers: svpn rewrites /etc/resolv.conf on Linux. On macOS it
# publishes them as a service of its own in the system configuration, which
# macOS uses as split DNS for the VPN's domains, leaving the default resolver
# alone.
dns_servers() {
  if [ "$OS" = Darwin ]; then
    printf 'show State:/Network/Service/F5NetworksServicePPP/DNS\n' | scutil 2>/dev/null | awk '
      /ServerAddresses/ { f = 1; next }
      f && /}/ { exit }
      f { printf " %s", $3 }'
  else
    nameservers "$RESOLV_CONF"
  fi
}

# The nameserver lines of a resolv.conf, on one line, from $1 or stdin.
nameservers() { awk '$1 == "nameserver" {printf " %s", $2}' "$@"; }

# svpn marks the resolv.conf it writes; the stub it hands back is unmarked.
svpn_dns() { grep -q 'F5 Networks' "$RESOLV_CONF" 2>/dev/null; }

# svpn's route installer walks only the first ten IPv4-addressed interfaces,
# and tun0 always has the highest ifindex, so nine other addressed interfaces
# are enough to hide the tunnel from it: it then spins on GetBestRoute2 and
# installs nothing at all, not even DNS. Docker bridges are the usual culprit.
# This is the Linux svpn's doing; nothing suggests the macOS one shares it.
addr_count() { ip -4 -o addr show 2>/dev/null | awk '$2 != "tun0"' | wc -l; }

no_routes_hint() {
  if [ "$OS" = Linux ]; then
    printf "svpn cannot see tun0 past %s addressed interfaces; try 'docker network prune'" "$(addr_count)"
  else
    printf 'see %s' "$CLIENT_LOGS"
  fi
}

# --- the browser --------------------------------------------------------------

require_client() {
  if [ "$OS" = Darwin ]; then
    [ -d "$CLIENT" ] || die "$CLIENT_NAME not found at $CLIENT — $CLIENT_HELP"
    [ -d "$EPI" ] || die "F5 Endpoint Inspector not found at $EPI — $CLIENT_HELP"
  else
    [ -x "$CLIENT" ] || die "$CLIENT_NAME not found — $CLIENT_HELP"
  fi
}

require_browser() {
  [ -n "$BROWSER" ] \
    || die "no Chromium-family browser found — install Google Chrome or Chromium, or set F5_BROWSER"
}

# Chromium encrypts cookies under a key from the OS keyring. On Linux,
# --password-store=basic makes that a fixed key, so read_sid can decrypt the
# cookie unaided. On macOS the key would live in the login Keychain, behind a
# prompt that a headless run can't answer; --use-mock-keychain keeps it out.
set_browser_args() {
  BROWSER_ARGS=("--user-data-dir=$PROFILE" --no-first-run --no-default-browser-check)
  if [ "$OS" = Darwin ]; then
    BROWSER_ARGS+=(--use-mock-keychain)
  else
    BROWSER_ARGS+=(--password-store=basic)
  fi
}

stop_browser() { pkill -f -- "--user-data-dir=$PROFILE" 2>/dev/null || true; }

# On macOS the browser runs under this helper, which drives it over the
# DevTools pipe and keeps the portal's MRHSession in $SID_LIVE. Chromium only
# writes session cookies to disk when the profile restores the last session,
# and on macOS its tracked-preference protection resets that setting the
# moment f5-cli changes it, so the cookie store never holds the session. The
# helper also ends the run when the last window closes, which on macOS leaves
# the browser itself running.
SID_LIVE=$RUNDIR/mrhsession
CDP_HELPER='
import json, os, select, signal, subprocess, sys, time

out, host, argv = sys.argv[1], sys.argv[2], sys.argv[3:]
cmd_r, cmd_w = os.pipe()
resp_r, resp_w = os.pipe()

def wire():
    a, b = os.dup(cmd_r), os.dup(resp_w)
    os.dup2(a, 3)
    os.dup2(b, 4)

browser = subprocess.Popen(argv + ["--remote-debugging-pipe"], preexec_fn=wire,
                           pass_fds=(3, 4), stdin=subprocess.DEVNULL)
os.close(cmd_r)
os.close(resp_w)
buf, seq = b"", 0

def call(method):
    global buf, seq
    seq += 1
    os.write(cmd_w, json.dumps({"id": seq, "method": method}).encode() + b"\0")
    deadline = time.time() + 5
    while True:
        while b"\0" in buf:
            msg, buf = buf.split(b"\0", 1)
            reply = json.loads(msg)
            if reply.get("id") == seq:
                return reply.get("result", {})
        left = deadline - time.time()
        if left <= 0 or not select.select([resp_r], [], [], left)[0]:
            raise TimeoutError(method)
        chunk = os.read(resp_r, 1 << 16)
        if not chunk:
            raise EOFError(method)
        buf += chunk

def publish(sid):
    if sid is None:
        if os.path.exists(out):
            os.unlink(out)
        return
    fd = os.open(out + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.write(fd, sid.encode())
    os.close(fd)
    os.replace(out + ".tmp", out)

def stop(*_):
    raise SystemExit(0)

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
had_page = False
try:
    while browser.poll() is None:
        try:
            cookies = call("Storage.getCookies").get("cookies", [])
            targets = call("Target.getTargets").get("targetInfos", [])
        except TimeoutError:
            continue
        except (OSError, EOFError):
            break
        publish(next((c["value"] for c in cookies
                      if c["name"] == "MRHSession" and c["domain"].lstrip(".") == host), None))
        if any(t.get("type") == "page" for t in targets):
            had_page = True
        elif had_page:
            break
        time.sleep(1)
finally:
    if browser.poll() is None:
        try:
            call("Browser.close")
            browser.wait(5)
        except Exception:
            browser.kill()
'

# Starts the browser on f5-cli's profile in the background, with any extra
# arguments, logging to $1; its pid is left in BROWSER_PID.
start_browser() {
  local log=$1
  shift
  set_browser_args
  if [ "$OS" = Darwin ]; then
    rm -f "$SID_LIVE"
    python3 -I -c "$CDP_HELPER" "$SID_LIVE" "$PORTAL" "$BROWSER" "${BROWSER_ARGS[@]}" "$@" \
      >"$log" 2>&1 9>&- &
  else
    "$BROWSER" "${BROWSER_ARGS[@]}" "$@" >"$log" 2>&1 9>&- &
  fi
  BROWSER_PID=$!
}

cookie_db() {
  local f
  for f in "$PROFILE/Default/Cookies" "$PROFILE/Default/Network/Cookies"; do
    [ -e "$f" ] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

# Two things have to go before a run. A stale MRHSession row would be read
# back as this run's session, so the inspection would be aimed at a session the
# portal has forgotten; and restoring the last session — which is what gets
# session cookies written to disk in the first place — reopens the previous
# tab, whose reload of hangup.php3 logs out the session the new tab just
# created. The Entra cookies stay: they are what makes the sign-in silent.
reset_browser_state() {
  local db f
  if db=$(cookie_db) && [ -w "$db" ]; then
    CKDB="$db" F5_PORTAL="$PORTAL" python3 -I -c '
import os, sqlite3
db = sqlite3.connect(os.environ["CKDB"])
db.execute("delete from cookies where host_key=?", (os.environ["F5_PORTAL"],))
db.commit()
' 2>/dev/null || true
  fi
  for f in Sessions "Current Session" "Current Tabs" "Last Session" "Last Tabs"; do
    rm -rf "${PROFILE:?}/Default/$f"
  done
}

# MRHSession is a session cookie, and Chromium only writes those to the on-disk
# cookie store when the profile is set to restore the last session (which
# macOS Chromium undoes; see CDP_HELPER). The
# protocol allowance is what the "Open f5vpn-ng?" prompt would otherwise store,
# so the inspection can start without anyone clicking it.
ensure_profile() {
  mkdir -p "$PROFILE/Default"; chmod 700 "$PROFILE"
  PROFILE="$PROFILE" PORTAL="$PORTAL" python3 -I -c '
import json, os, pathlib
p = pathlib.Path(os.environ["PROFILE"], "Default", "Preferences")
try:
    prefs = json.loads(p.read_text())
except (OSError, ValueError):
    prefs = {}
before = json.dumps(prefs, sort_keys=True)
prefs.setdefault("session", {})["restore_on_startup"] = 1
origin = "https://" + os.environ["PORTAL"]
pairs = prefs.setdefault("protocol_handler", {}).setdefault("allowed_origin_protocol_pairs", {})
pairs.setdefault(origin, {}).update({"f5-epi": True, "f5-vpn": True})
if json.dumps(prefs, sort_keys=True) != before:
    p.write_text(json.dumps(prefs))
'
}

# With --password-store=basic, cookies are "v10": AES-128-CBC under a PBKDF2
# key derived from a fixed password, IV of sixteen spaces. Recent Chromium
# prefixes the plaintext with the sha256 of the cookie's host. On macOS the
# browser helper has already put the session in $SID_LIVE.
read_sid() {
  local tmp db ext
  if [ "$OS" = Darwin ]; then
    [ -s "$SID_LIVE" ] && cat "$SID_LIVE"
    return
  fi
  db=$(cookie_db) && [ -r "$db" ] || return 1
  tmp=$(mktemp -d "$RUNDIR/ck.XXXXXX") || return 1
  trap 'rm -rf "$tmp"' RETURN
  cp -f "$db" "$tmp/Cookies"
  for ext in -wal -shm; do
    [ -f "$db$ext" ] && cp -f "$db$ext" "$tmp/Cookies$ext"
  done
  F5_PORTAL="$PORTAL" CKDB="$tmp/Cookies" python3 -I -c '
import hashlib, os, sqlite3, subprocess, sys
host = os.environ["F5_PORTAL"]
row = sqlite3.connect(os.environ["CKDB"]).execute(
    "select encrypted_value from cookies where host_key=? and name=?", (host, "MRHSession")
).fetchone()
if row is None or row[0][:3] != b"v10":
    sys.exit(1)
key = hashlib.pbkdf2_hmac("sha1", b"peanuts", b"saltysalt", 1, 16)
pt = subprocess.run(
    ["openssl", "enc", "-d", "-aes-128-cbc", "-K", key.hex(), "-iv", "20" * 16],
    input=row[0][3:], capture_output=True, check=True,
).stdout
if pt[:32] == hashlib.sha256(host.encode()).digest():
    pt = pt[32:]
print(pt.decode())
' 2>/dev/null
}

# The portal hands out an MRHSession before the access policy has run, so only
# an authorised resource tells us the session is really signed in: 200 once the
# policy has completed, 404 while it is still pending, 302 once it has expired.
sid_is_live() {
  local code
  [ -n "${1:-}" ] || return 1
  code=$(curl -s -o /dev/null --max-time 15 -w '%{http_code}' \
         -H "Cookie: MRHSession=$1" "https://$PORTAL/vdesk/resource_template")
  [ "$code" = "200" ]
}

save_sid() { mkdir -p "$STATEDIR"; chmod 700 "$STATEDIR"; (umask 077; printf '%s\n' "$1" >"$SIDFILE"); }

# The endpoint inspection the access policy waits for: machine info plus two
# OESIS passes, posted back to /my.policy_host, after which the policy lets the
# session through to the webtop. On macOS the inspector is its own app, which
# quits once it has posted; `open -W` waits for that.
run_epc() {
  local uri="f5-epi://$PORTAL?server=$PORTAL&protocol=https&port=443&sid=$1"
  if [ "$OS" = Darwin ]; then
    with_timeout 120 open -W -g -a "$EPI" "$uri" >"$RUNDIR/epc.log" 2>&1 9>&- || true
  else
    timeout 120 env -u DISPLAY -u WAYLAND_DISPLAY -u GDK_BACKEND "$CLIENT" "$uri" \
      >"$RUNDIR/epc.log" 2>&1 9>&- || true
  fi
}

# No window and no interaction: the profile's persistent Entra cookie carries
# the SAML round trip, and the inspection is run here rather than by the
# browser, which cannot launch an external protocol while headless.
browser_sso() {
  local pid sid i
  require_browser
  ensure_profile
  stop_browser
  reset_browser_state
  msg "refreshing the portal session in the background"
  start_browser "$RUNDIR/browser-sso.log" --headless=new --disable-gpu "https://$PORTAL/"
  pid=$BROWSER_PID
  for i in $(seq 1 20); do
    sleep 2
    sid=$(read_sid) && [ -n "$sid" ] && break
  done
  # The inspection only lands once the SAML round trip has handed the policy
  # its next agent, so give the first attempt a moment and retry if it is early.
  for _ in 1 2 3; do
    [ -n "${sid:-}" ] || break
    sleep 4
    msg "running the endpoint inspection"
    run_epc "$sid"
    for i in $(seq 1 8); do
      sid=$(read_sid) || sid=
      if sid_is_live "$sid"; then
        save_sid "$sid"
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        return 0
      fi
      sleep 2
    done
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  return 1
}

get_live_sid() {
  local sid
  sid=$(cat "$SIDFILE" 2>/dev/null) || sid=
  sid_is_live "$sid" && { printf '%s' "$sid"; return 0; }

  sid=$(read_sid) || sid=
  sid_is_live "$sid" && { save_sid "$sid"; printf '%s' "$sid"; return 0; }

  browser_sso && { cat "$SIDFILE"; return 0; }

  has_display || return 1
  warn "the Entra sign-in has lapsed — opening a browser window"
  cmd_login || return 1
  cat "$SIDFILE"
}

cmd_login() {
  local pid sid i db epc_done=0
  require_browser
  require_client
  has_display || die "login needs a graphical session to open a browser window"
  ensure_profile
  stop_browser
  reset_browser_state
  msg "opening https://$PORTAL/ — sign in, and tick \"Stay signed in\" so later"
  msg "connects need no interaction. The window closes itself when you're in."
  start_browser "$RUNDIR/browser.log" "https://$PORTAL/"
  pid=$BROWSER_PID
  for i in $(seq 1 150); do
    sleep 2
    kill -0 "$pid" 2>/dev/null || break
    sid=$(read_sid) || continue
    if sid_is_live "$sid"; then
      save_sid "$sid"
      msg "signed in — portal session captured"
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      if ! db=$(cookie_db) || ! grep -qa ESTSAUTHPERSISTENT "$db"; then
        warn "no persistent Entra cookie saved — headless re-auth will need \"Stay signed in\""
      fi
      return 0
    fi
    # The policy stalls here if the browser never handed the inspection over.
    if [ -n "$sid" ] && [ "$i" -ge 8 ] && [ $(( (i - 8) % 15 )) -eq 0 ] && [ "$epc_done" -lt 3 ]; then
      msg "running the endpoint inspection"
      run_epc "$sid"
      epc_done=$(( epc_done + 1 ))
    fi
  done
  kill "$pid" 2>/dev/null || true
  die "no portal session appeared — sign-in did not complete"
}

# The network-access resource the policy grants, as the webtop lists it.
discover_resource() {
  local list
  list=$(curl -s --max-time 15 -H "Cookie: MRHSession=$1" \
         "https://$PORTAL/vdesk/resource_list.xml?resourcetype=res" \
         | sed -n "s/.*<list type='network_access'><entry[^>]*>\([^<]*\)<.*/\1/p")
  case $list in
    "") return 1 ;;
    *" "*) warn "the portal offers several VPN resources: $list"; return 1 ;;
  esac
  printf '%s' "$list"
}

# The launch URI the webtop's JS would build: a dummy sid, an md5 of the link
# as `token`, and a one-time code from get_token_for_sessid.php3 as `otc`, which
# the client exchanges for the real tunnel session. The portal rejects a plain
# webtop MRHSession here, so the otc is what actually authorises the tunnel.
build_launch_uri() {
  local sid=$1 resource=$2 otc link
  otc=$(curl -s -D - -o /dev/null --max-time 15 -H "Cookie: MRHSession=$sid" \
        "https://$PORTAL/vdesk/get_token_for_sessid.php3" \
        | awk 'tolower($1) == "x-access-session-token:" {gsub(/\r/, ""); print $2; exit}')
  [ -n "$otc" ] || return 1
  link="f5-vpn://$PORTAL?server=$PORTAL&resourcename=$resource"
  link+="&resourcetype=network_access&cmd=launch&protocol=https&port=443"
  link+="&sid=nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn"
  printf '%s&token=%s&otc=%s' "$link" "$(printf '%s' "$link" | openssl dgst -md5 | awk '{print $NF}')" "$otc"
}

# Headless on Linux when there is no display. On macOS the client has no
# headless mode, so its window opens in the background.
launch_client() {
  if [ "$OS" = Darwin ]; then
    open -g --stdout "$CLIENT_LOG" --stderr "$CLIENT_LOG" -a "$CLIENT" "$1" 9>&-
  else
    setsid env -u DISPLAY -u WAYLAND_DISPLAY -u GDK_BACKEND \
      "$CLIENT" "$1" </dev/null >"$CLIENT_LOG" 2>&1 9>&- &
    disown || true
  fi
}

wait_for_network() {
  local i
  for i in $(seq 0 "$NETWORK_WAIT"); do
    resolves "$PORTAL" && return 0
    [ "$i" -lt "$NETWORK_WAIT" ] && sleep 1
  done
  die "cannot resolve $PORTAL — is the network up?"
}

# svpn rewrites /etc/resolv.conf in place and hands back a copy of resolved's
# stub on the way out, leaving a plain file where the symlink was. If svpn is
# killed instead (a shutdown, a crash) it never hands anything back, and the
# VPN's nameservers, unreachable without the tunnel, outlive it. macOS keeps
# its resolvers in the system configuration instead, so this is Linux only.
# The link's relative target is the one for /etc/resolv.conf itself.
restore_resolv_conf() {
  [ "$OS" = Linux ] || return 0
  [ -L "$RESOLV_CONF" ] && return 0
  if svpn_dns; then
    pgrep -x svpn >/dev/null && return 0
    warn "$RESOLV_CONF still points at the VPN's DNS but svpn is not running — restoring it"
  elif ! grep -q stub-resolv.conf "$RESOLV_CONF" 2>/dev/null; then
    return 0
  fi
  [ -e /run/systemd/resolve/stub-resolv.conf ] \
    || { warn "$RESOLV_CONF was left by svpn and systemd-resolved is not running — fix it by hand"; return 0; }
  sudo -n ln -sf ../run/systemd/resolve/stub-resolv.conf "$RESOLV_CONF" 2>/dev/null \
    || warn "$RESOLV_CONF was left by svpn; relink it with: sudo ln -sf ../run/systemd/resolve/stub-resolv.conf $RESOLV_CONF"
}

# The interface that came up since `before` was taken.
new_tunnel() {
  local i
  for i in $(tunnel_candidates); do
    printf '%s\n' "$1" | grep -qx "$i" && continue
    printf '%s' "$i"; return 0
  done
  return 1
}

cmd_up() {
  local sid resource uri others i iface before n prev
  require_client
  iface=$(tunnel_iface) || iface=
  if [ -n "$iface" ] && [ "$(route_count "$iface")" -gt 5 ]; then
    msg "already connected ($(route_count "$iface") routes on $iface)"; return 0
  fi
  if [ -n "$iface" ] || { [ "$OS" = Darwin ] && pgrep -x svpn >/dev/null; }; then
    warn "stale tunnel${iface:+ on $iface} with $(route_count "$iface") route(s) — tearing down first"
    cmd_down || true
  fi
  restore_resolv_conf
  wait_for_network

  if [ "$OS" = Linux ]; then
    others=$(addr_count)
    if [ "$others" -ge 8 ]; then
      warn "$others interfaces hold an IPv4 address — svpn reads ten and tun0 comes last; 'docker network prune' buys room"
    fi
  fi

  sid=$(get_live_sid) || die "no portal session — run 'f5-cli login'"
  msg "portal session OK (…${sid: -6})"

  resource=$RESOURCE
  if [ -z "$resource" ]; then
    resource=$(discover_resource "$sid") || die "could not pick the VPN resource — set F5_RESOURCE"
  fi
  uri=$(build_launch_uri "$sid" "$resource") || die "portal would not issue a one-time code"

  msg "starting $CLIENT_NAME ($resource)"
  before=$(tunnel_candidates)
  rm -f "$IFACE_FILE"
  launch_client "$uri"

  iface=
  for i in $(seq 1 60); do
    iface=$(new_tunnel "$before") && break
    iface=
    sleep 1
  done
  if [ -z "$iface" ]; then
    [ "$OS" = Darwin ] && warn "if $CLIENT_NAME is showing a dialog (an update offer, say), answer it and run 'f5-cli up' again"
    die "the tunnel never came up — see $CLIENT_LOG and $CLIENT_LOGS"
  fi
  printf '%s\n' "$iface" >"$IFACE_FILE"
  msg "$iface up: $(tunnel_addr "$iface")"

  for i in $(seq 1 30); do
    [ "$(route_count "$iface")" -gt 5 ] && break
    sleep 1
  done
  [ "$(route_count "$iface")" -gt 5 ] || die "no routes on $iface — $(no_routes_hint)"
  # macOS's svpn adds its routes over several seconds and sets DNS last, so
  # wait for the route count to hold still with DNS in place.
  if [ "$OS" = Darwin ]; then
    prev=0
    for i in $(seq 1 20); do
      n=$(route_count "$iface")
      [ -n "$(dns_servers)" ] && [ "$n" -eq "$prev" ] && break
      prev=$n
      sleep 1
    done
    [ -n "$(dns_servers)" ] || warn "svpn has not set the VPN's DNS yet — internal names may not resolve"
  else
    # Linux's svpn rewrites resolv.conf only after the routes are in.
    for i in $(seq 1 15); do
      svpn_dns && break
      sleep 1
    done
    svpn_dns || warn "svpn has not set the VPN's DNS yet — internal names may not resolve"
  fi
  msg "connected: $(route_count "$iface") routes, DNS via$(dns_servers)"
}

# Stopping the client is enough: it tells svpn to disconnect, and svpn takes
# the tunnel down and exits a few seconds later.
cmd_down() {
  local i
  pkill -x "$CLIENT_NAME" 2>/dev/null || true
  for i in $(seq 1 15); do
    pgrep -x svpn >/dev/null || break
    sleep 1
  done
  if pgrep -x svpn >/dev/null; then
    # macOS's svpn is setuid root but runs as you, so you may signal it.
    pkill -x svpn 2>/dev/null || sudo -n pkill -x svpn 2>/dev/null \
      || warn "svpn is still running — stop it with: sudo pkill -x svpn"
    # Until it has gone, restore_resolv_conf takes its DNS for a live tunnel's.
    for i in $(seq 1 5); do
      pgrep -x svpn >/dev/null || break
      sleep 1
    done
  fi
  rm -f "$IFACE_FILE"
  restore_resolv_conf
  msg "disconnected"
}

cmd_status() {
  local n iface
  if ! iface=$(tunnel_iface); then
    echo "tunnel: absent — not connected"
    [ "$OS" = Linux ] && svpn_dns && ! pgrep -x svpn >/dev/null \
      && warn "$RESOLV_CONF still points at the VPN's DNS — 'f5-cli down' restores it"
    return 1
  fi
  n=$(route_count "$iface")
  echo "$iface: $(tunnel_addr "$iface")   routes: $n"
  echo "dns:$(dns_servers)"
  [ "$n" -gt 5 ] || { warn "only $n route(s) — $(no_routes_hint)"; return 1; }
}

cmd_session() {
  get_live_sid >/dev/null || die "no portal session — run 'f5-cli login'"
  msg "portal session is live"
}

# ─── Bridge ────────────────────────────────────────────────────────────────
# The F5 client belongs to the host, so a container (a devcontainer, say)
# can't run it. `install.sh --bridge` runs `f5-cli bridge serve` on the host:
# a small HTTP server on the host's 127.0.0.1 that runs the commands in
# BRIDGED, and nothing else, for a caller holding the token in BRIDGE_FILE.
# With the host's config directory mounted into the container, f5-cli there
# sends those commands to the bridge instead of running them.
BRIDGE_FILE=${F5_BRIDGE_FILE:-$(dirname "$CONFIG")/bridge}
BRIDGED="status up down login session version dns"
BRIDGE_SENTINEL=__f5_cli_bridge_exit__

# F5_IN_CONTAINER=0|1 overrides the detection.
in_container() {
  case ${F5_IN_CONTAINER:-} in
    0) return 1 ;;
    1) return 0 ;;
  esac
  [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ]
}

bridge_value() { sed -n "s/^$1=//p" "$BRIDGE_FILE" 2>/dev/null | tail -n 1; }

# Docker Desktop reaches the host's loopback as host.docker.internal. A
# container on the host's network (--network=host on Linux) shares it.
bridge_host() {
  if [ -n "${F5_BRIDGE_HOST:-}" ]; then
    echo "$F5_BRIDGE_HOST"
  elif getent hosts host.docker.internal >/dev/null 2>&1; then
    echo host.docker.internal
  else
    echo 127.0.0.1
  fi
}

# Runs one command on the host through the bridge, streaming its output, and
# returns its exit status. The token goes to curl on stdin, never in argv.
bridge_call() {
  local cmd=$1 host port token line rc=
  [ -r "$BRIDGE_FILE" ] \
    || die "no f5-cli bridge is set up — run 'install.sh --bridge' on the host, and mount its $(dirname "$BRIDGE_FILE") into this container"
  port=$(bridge_value PORT)
  token=$(bridge_value TOKEN)
  [ -n "$port" ] && [ -n "$token" ] || die "$BRIDGE_FILE is incomplete — re-run 'install.sh --bridge' on the host"
  command -v curl >/dev/null || die "the bridge needs curl"
  host=$(bridge_host)
  while IFS= read -r line; do
    case $line in
      "$BRIDGE_SENTINEL "*) rc=${line#"$BRIDGE_SENTINEL "} ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < <(printf 'header = "Authorization: Bearer %s"\n' "$token" \
    | curl -sS -N --connect-timeout 3 --max-time 900 --config - --data-raw "$cmd" "http://$host:$port/run" 2>&1)
  case $rc in
    '' | *[!0-9]*) die "no answer from the f5-cli bridge at $host:$port — is it running on the host? ('install.sh --bridge' there)" ;;
  esac
  return "$rc"
}

# 0: the bridge answers. 1: it's set up but doesn't. 2: it isn't set up.
cmd_bridge_status() {
  local host port out
  if [ ! -r "$BRIDGE_FILE" ]; then
    echo "bridge: not set up — run 'install.sh --bridge' on the host"
    return 2
  fi
  if in_container; then host=$(bridge_host); else host=127.0.0.1; fi
  port=$(bridge_value PORT)
  if out=$(F5_BRIDGE_HOST=$host bridge_call version 2>&1); then
    echo "bridge: http://$host:$port — host runs $out"
    return 0
  fi
  echo "bridge: http://$host:$port — not answering: $(printf '%s\n' "$out" | tail -n 1)"
  return 1
}

# svpn points the host's /etc/resolv.conf at the VPN's DNS, but a container on
# the host's network resolving through resolved's stub at 127.0.0.53 never
# hears of it. `dns` prints the host's resolver lines so a container can copy
# them. On macOS svpn leaves /etc/resolv.conf alone and uses split DNS, which
# Docker Desktop's own resolver already follows, so there is nothing to copy.
resolv_lines() { grep -E '^[[:space:]]*(nameserver|search|domain|options)([[:space:]]|$)' || true; }

# `dns [--apply]`, on either side; sets DNS_APPLY.
parse_dns_args() {
  DNS_APPLY=0
  case $#:${1:-} in
    0:) return 0 ;;
    1:--apply) DNS_APPLY=1; return 0 ;;
  esac
  usage >&2
  exit 2
}

cmd_dns() {
  [ "$DNS_APPLY" = 0 ] \
    || die "'dns --apply' copies the host's DNS into a container; on the host there is nothing to do"
  [ "$OS" = Darwin ] && return 0
  [ -r "$RESOLV_CONF" ] || die "cannot read $RESOLV_CONF"
  resolv_lines <"$RESOLV_CONF"
}

# The host's resolver lines, through the bridge.
bridge_dns() {
  local out rc=0
  out=$(bridge_call dns) || rc=$?
  if [ "$rc" -ne 0 ]; then
    case $out in
      *"not a bridged command"*)
        warn "the host's f5-cli is too old for dns — update it there and re-run 'install.sh --bridge'"
        return 1
        ;;
    esac
    [ -z "$out" ] || printf '%s\n' "$out" >&2
    return "$rc"
  fi
  printf '%s\n' "$out" | resolv_lines
}

# Docker bind-mounts /etc/resolv.conf into the container, so it can be
# rewritten but not replaced: a write in place, never a rename.
dns_apply() {
  local lines
  lines=$(bridge_dns) || return 1
  if [ -z "$lines" ]; then
    msg "the host has no DNS for a container to copy — $RESOLV_CONF left alone"
    return 0
  fi
  if [ -z "$(printf '%s\n' "$lines" | nameservers)" ]; then
    warn "the host's DNS has no nameserver — $RESOLV_CONF left alone"
    return 1
  fi
  if [ "$(cat "$RESOLV_CONF" 2>/dev/null)" = "$lines" ]; then
    msg "$RESOLV_CONF already has the host's DNS"
    return 0
  fi
  if { printf '%s\n' "$lines" >"$RESOLV_CONF"; } 2>/dev/null \
    || printf '%s\n' "$lines" | sudo -n tee "$RESOLV_CONF" >/dev/null 2>&1; then
    msg "copied the host's DNS to $RESOLV_CONF:$(printf '%s\n' "$lines" | nameservers)"
    return 0
  fi
  warn "could not write $RESOLV_CONF — run as root, or with sudo that needs no password"
  return 1
}

# Standard library only, and Python 3.9, which is what macOS's Command Line
# Tools ship. Run as: python3 -c "$BRIDGE_SERVER" <bridge-file> <f5-cli>.
BRIDGE_SERVER='
import hmac
import http.server
import subprocess
import sys

ALLOWED = sys.argv[3].split()
SENTINEL = sys.argv[4]


def load(path):
    state = {}
    with open(path) as f:
        for line in f:
            key, sep, value = line.strip().partition("=")
            if sep:
                state[key] = value
    for key in ("PORT", "TOKEN"):
        if not state.get(key):
            sys.exit(f"f5-cli bridge: {path} has no {key}; re-run install.sh --bridge")
    return state


def handler(token, f5):
    expected = ("Bearer " + token).encode()

    class Handler(http.server.BaseHTTPRequestHandler):
        # No Content-Length: the response ends when the connection closes,
        # so the output streams while the command runs.
        protocol_version = "HTTP/1.0"

        def do_POST(self):
            if self.path != "/run":
                return self.refuse(404, "no such endpoint")
            if not hmac.compare_digest(self.headers.get("Authorization", "").encode(), expected):
                return self.refuse(401, "bad token; re-run install.sh --bridge on the host")
            length = int(self.headers.get("Content-Length") or 0)
            if length > 64:
                return self.refuse(400, "request too large")
            cmd = self.rfile.read(length).decode("utf-8", "replace").strip()
            if cmd not in ALLOWED:
                return self.refuse(400, f"not a bridged command: {cmd!r}")
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            proc = subprocess.Popen([f5, cmd], stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            try:
                for line in proc.stdout:
                    self.wfile.write(line)
                    self.wfile.flush()
                self.wfile.write(f"{SENTINEL} {proc.wait()}\n".encode())
            except (BrokenPipeError, ConnectionResetError):
                # The caller went away. Let the command finish, draining its
                # output so it cannot block on a full pipe.
                for _ in proc.stdout:
                    pass
                proc.wait()

        def do_GET(self):
            self.refuse(405, "use POST /run")

        def refuse(self, code, message):
            self.send_response(code)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(f"f5-cli bridge: {message}\n{SENTINEL} 2\n".encode())

        def log_message(self, fmt, *args):
            # The request line and status only, never the headers.
            sys.stderr.write(f"{self.log_date_time_string()} {fmt % args}\n")

    return Handler


state = load(sys.argv[1])
bind = state.get("BIND") or "127.0.0.1"
port = int(state["PORT"])
server = http.server.ThreadingHTTPServer((bind, port), handler(state["TOKEN"], sys.argv[2]))
sys.stderr.write(f"f5-cli bridge: listening on {bind}:{port}\n")
sys.stderr.flush()
try:
    server.serve_forever()
except KeyboardInterrupt:
    pass
'

cmd_bridge_serve() {
  local self
  in_container && die "the bridge runs on the host, not in a container"
  [ -r "$BRIDGE_FILE" ] || die "no $BRIDGE_FILE — run 'install.sh --bridge'"
  self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  exec python3 -I -c "$BRIDGE_SERVER" "$BRIDGE_FILE" "$self" "$BRIDGED" "$BRIDGE_SENTINEL"
}

# A second client hands its URI to the running one, which drops the session
# it was bringing up, so commands that start or stop the client take turns.
# Children are started with fd 9 closed so the client can't keep the lock.
#
# macOS has no flock(1). An flock(2) lock belongs to the open file, which
# python3 shares with this shell as fd 9, so the lock it takes outlives it.
lock() {
  if command -v flock >/dev/null; then
    flock "$@" 9
  else
    python3 -I -c '
import fcntl, sys
fcntl.flock(9, fcntl.LOCK_EX | (fcntl.LOCK_NB if "-n" in sys.argv[1:] else 0))
' "$@" 2>/dev/null
  fi
}

take_lock() {
  exec 9>"$RUNDIR/lock"
  lock -n && return 0
  msg "another f5-cli is running — waiting for it to finish"
  lock
}

usage() {
  cat <<EOF
f5-cli $VERSION — F5 VPN from the terminal

usage: f5-cli <command>

  login     sign in once in a browser window (tick "Stay signed in")
  up        connect, refreshing the portal session headlessly if needed
  down      disconnect
  status    show the tunnel; exits non-zero when not connected
  session   check the portal session, refreshing it if needed
  version   print the version
  dns       print the resolver lines of /etc/resolv.conf (nothing on macOS)

  bridge status   whether the bridge for containers answers
  bridge serve    run the bridge (install.sh --bridge does this for you)
  dns --apply     in a container: copy the host's resolver lines into its
                  /etc/resolv.conf

In a container, status, up, down, login, session and dns run on the host
through its bridge — see 'install.sh --bridge'. With F5_BRIDGE_SYNC_DNS=1, up
and down then also run 'dns --apply'.

portal: $PORTAL   config: $CONFIG
EOF
}

# In a container, everything that drives the client goes through the bridge.
if in_container; then
  case "${1:-help}" in
    status|login|session) bridge_call "$1"; exit ;;
    # Whatever up or down exits with: an `up` that finds the tunnel already
    # there exits 0, and the sync then repairs a container left on stale DNS.
    up|down)
      rc=0
      bridge_call "$1" || rc=$?
      [ "${F5_BRIDGE_SYNC_DNS:-0}" = 1 ] && { dns_apply || true; }
      exit "$rc"
      ;;
    dns)
      parse_dns_args "${@:2}"
      if [ "$DNS_APPLY" = 1 ]; then dns_apply; else bridge_dns; fi
      exit
      ;;
    bridge)
      [ "${2:-}" = status ] || die "in a container, only 'f5-cli bridge status' — the bridge itself runs on the host"
      cmd_bridge_status; exit
      ;;
  esac
fi

case "${1:-help}" in
  up)                  take_lock; cmd_up ;;
  down)                take_lock; cmd_down ;;
  status)              cmd_status ;;
  login)               take_lock; cmd_login ;;
  session)             take_lock; cmd_session ;;
  version|--version)   echo "f5-cli $VERSION" ;;
  dns)                 parse_dns_args "${@:2}"; cmd_dns ;;
  bridge)
    case "${2:-}" in
      serve)  cmd_bridge_serve ;;
      status) cmd_bridge_status ;;
      *)      usage >&2; exit 2 ;;
    esac
    ;;
  help|--help|-h)      usage ;;
  *)                   usage >&2; exit 2 ;;
esac
